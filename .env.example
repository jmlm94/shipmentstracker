# ----------------------------------------------------------------------------
# Database (PostgreSQL). On Vercel, add a Postgres store (Neon / Vercel Postgres
# / Supabase) and it will populate these automatically.
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ----------------------------------------------------------------------------
# Dashboard access. Single shared password for CEO / COO to view the dashboard.
# ----------------------------------------------------------------------------
DASHBOARD_PASSWORD="change-me"

# Your company name, shown as a header on the supplier form (branding).
NEXT_PUBLIC_COMPANY_NAME="Your Company"

# ----------------------------------------------------------------------------
# Slack notifications. Create an Incoming Webhook in your Slack workspace and
# paste the URL here. Notifications fire when a box changes status.
# ----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=""

# ----------------------------------------------------------------------------
# Carrier tracking provider. Used by the daily cron to refresh shipping status.
# Supported: "easypost" or "none" (manual-only).
# ----------------------------------------------------------------------------
TRACKING_PROVIDER="none"
EASYPOST_API_KEY=""

# ----------------------------------------------------------------------------
# Protects the daily cron endpoint. Vercel Cron sends this automatically when
# set as a project env var; also required for manual triggers.
# ----------------------------------------------------------------------------
CRON_SECRET=""
