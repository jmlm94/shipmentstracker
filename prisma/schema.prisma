generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Keep all of this app's tables in their own schema so it can safely share a
  // database with other projects. `prisma db push` only manages this schema and
  // will never touch tables in `public` (e.g. another project's data).
  schemas  = ["shipments"]
}

// A single shipment submitted by a supplier. The shipment-level fields are
// entered once; each physical box is a Box row so every box is tracked
// individually (e.g. 50 boxes => 50 Box rows, each with its own tracking #).
model Shipment {
  id              String   @id @default(cuid())
  code            String   @unique          // human-friendly batch code, e.g. SHP-7K3Q9P
  supplierName    String
  supplierEmail   String?
  shipmentDate    DateTime
  carrier         Carrier
  shippingMethod  ShippingMethod
  boxesTotal      Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  boxes           Box[]

  @@index([createdAt])
  @@index([code])
  @@schema("shipments")
}

// One physical box. The core unit of tracking.
model Box {
  id              String     @id @default(cuid())
  shipment        Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId      String

  boxNumber       Int            // sequential within the shipment (1..N)
  productId       String         // SKU / Product ID
  productName     String?
  trackingNumber  String         @unique
  unitsPerBox     Int
  weightOfBox     Float          // weight declared by supplier (lbs)

  // Lifecycle status. Updated automatically by carrier tracking and manually
  // at the warehouse during receiving (Station #1).
  status          BoxStatus  @default(PENDING)

  // Warehouse receiving fields (Station #1).
  weightReceived  Float?
  condition       BoxCondition?  // GOOD or LOST_UNITS
  unitsReceived   Int?
  deliveredAt     DateTime?

  // Set when received quantity/weight doesn't match what the supplier declared.
  hasDiscrepancy  Boolean    @default(false)

  // Latest carrier tracking snapshot.
  lastCarrierStatus  String?
  lastCheckedAt      DateTime?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  events          StatusEvent[]
  photos          BoxPhoto[]

  @@index([shipmentId])
  @@index([status])
  @@index([trackingNumber])
  @@schema("shipments")
}

// Photo evidence for a box (e.g. the SOP's "6 photos" of damaged / lost units).
model BoxPhoto {
  id        String   @id @default(cuid())
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId     String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@index([boxId])
  @@schema("shipments")
}

// Audit log of every status change. Drives Slack notifications.
model StatusEvent {
  id          String   @id @default(cuid())
  box         Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId       String
  fromStatus  String?
  toStatus    String
  message     String?
  source      String   // "carrier", "warehouse", "supplier"
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([boxId])
  @@index([createdAt])
  @@schema("shipments")
}

// Catalog of SKUs. Defining a product once lets the supplier form auto-fill
// names and powers the printable QR box labels. Tier mirrors the SOP's
// A / B / C warehouse zones.
model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  tier        Tier     @default(A)
  unitsPerBox Int?     // typical units per box, used to pre-fill labels/forms
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sku])
  @@schema("shipments")
}

enum Tier {
  A
  B
  C

  @@schema("shipments")
}

enum Carrier {
  FEDEX
  DHL
  UPS

  @@schema("shipments")
}

enum ShippingMethod {
  AIR
  SEA

  @@schema("shipments")
}

enum BoxStatus {
  PENDING        // submitted, not yet picked up / scanned by carrier ("Not shipped")
  IN_TRANSIT
  DELAYED        // stuck: customs / exception / no movement
  DELIVERED      // arrived at warehouse per carrier
  DAMAGED        // arrived damaged
  ADDED_IN_STOCK // received & added to inventory (warehouse)
  LOST

  @@schema("shipments")
}

enum BoxCondition {
  GOOD
  LOST_UNITS

  @@schema("shipments")
}
