generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Keep all of this app's tables in their own schema so it can safely share a
  // database with other projects. `prisma db push` only manages this schema and
  // will never touch tables in `public` (e.g. another project's data).
  schemas  = ["shipments"]
}

// A single shipment submitted by a supplier. Shipment-level fields are entered
// once. The supplier then adds one ShipmentLine per SKU; each line is expanded
// into individual Box rows (one per physical box) so every box is tracked.
model Shipment {
  id                   String   @id @default(cuid())
  code                 String   @unique          // human-friendly batch code, e.g. SHP-7K3Q9P
  poNumber             String?                   // Purchase Order number
  supplierName         String
  supplierEmail        String?
  shipmentDate         DateTime
  expectedDeliveryDate DateTime?                 // supplier-provided ETA (else computed from lead time)
  notes                String?
  boxesTotal           Int
  manuallyAdded        Boolean  @default(false)  // created from the dashboard vs the supplier form
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?

  lines           ShipmentLine[]
  boxes           Box[]

  @@index([createdAt])
  @@index([code])
  @@index([purchaseOrderId])
  @@schema("shipments")
}

// A purchase order the team creates BEFORE goods ship. Suppliers locate it on
// the intake form so their shipment matches what was ordered, and receiving
// rolls up against the ordered quantities.
model PurchaseOrder {
  id              String   @id @default(cuid())
  code            String   @unique          // e.g. PO-0001
  supplierName    String
  supplierEmail   String?
  supplierContact String?
  status          PoStatus @default(OPEN)
  orderDate       DateTime @default(now())
  expectedDate    DateTime?
  currency        String   @default("USD")
  shippingCost    Float    @default(0)
  otherCost       Float    @default(0)
  otherCostLabel  String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           PurchaseOrderItem[]
  shipments       Shipment[]

  @@index([status])
  @@index([code])
  @@schema("shipments")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  productId       String
  productName     String
  productImage    String?
  sku             String?
  quantity        Int
  unitCost        Float   @default(0)

  @@index([purchaseOrderId])
  @@schema("shipments")
}

enum PoStatus {
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@schema("shipments")
}

// The "plan" for one SKU within a shipment: which product, how many boxes, and
// how they're shipped. Lets us compare plan vs. what's actually received.
model ShipmentLine {
  id              String   @id @default(cuid())
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId      String

  productId       String          // Shopify handle (stable id)
  productName     String          // product title
  productSku      String?         // Shopify SKU when available
  productImage    String?

  boxCount        Int
  unitsPerBox     Int
  weightPerBox    Float           // lbs, per box
  shippingMethod  ShippingMethod  // one method for the whole SKU line
  carrier         Carrier
  trackingPerBox  Boolean  @default(false) // true = each box has its own tracking #
  trackingNumber  String?         // the batch tracking # (null when per-box)

  boxes           Box[]

  @@index([shipmentId])
  @@schema("shipments")
}

// One physical box. The core unit of tracking. Carries its own internal code
// (printed on the sticker QR) used for receiving and plan-vs-actual checks.
model Box {
  id              String     @id @default(cuid())
  shipment        Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId      String
  line            ShipmentLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  lineId          String

  boxCode         String     @unique   // internal per-box id, e.g. SHP-7K3Q9P-01
  boxNumber       Int            // sequential within the shipment (1..N)

  productId       String         // Shopify handle
  productName     String?        // product title
  productImage    String?
  trackingNumber  String         // carrier tracking (shared per SKU line, not unique)
  unitsPerBox     Int
  weightOfBox     Float          // weight declared by supplier (lbs)
  shippingMethod  ShippingMethod
  carrier         Carrier

  // Lifecycle status. Updated automatically by carrier tracking and manually
  // at the warehouse during receiving (Station #1).
  status          BoxStatus  @default(PENDING)

  // Warehouse receiving fields (Station #1).
  weightReceived  Float?
  condition       BoxCondition?  // GOOD or LOST_UNITS
  unitsReceived   Int?
  receivedBy      String?
  deliveredAt     DateTime?

  // Set when an overdue Slack alert has been sent (prevents duplicate alerts).
  overdueNotifiedAt  DateTime?

  // Set when received quantity/weight doesn't match what the supplier declared.
  hasDiscrepancy  Boolean    @default(false)

  // Latest carrier tracking snapshot.
  lastCarrierStatus  String?
  lastCheckedAt      DateTime?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  events          StatusEvent[]
  photos          BoxPhoto[]

  @@index([shipmentId])
  @@index([lineId])
  @@index([status])
  @@index([boxCode])
  @@index([trackingNumber])
  @@schema("shipments")
}

// Photo evidence for a box (e.g. the SOP's "6 photos" of damaged / lost units).
model BoxPhoto {
  id        String   @id @default(cuid())
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId     String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@index([boxId])
  @@schema("shipments")
}

// Audit log of every status change. Drives Slack notifications.
model StatusEvent {
  id          String   @id @default(cuid())
  box         Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId       String
  fromStatus  String?
  toStatus    String
  message     String?
  source      String   // "carrier", "warehouse", "supplier"
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([boxId])
  @@index([createdAt])
  @@schema("shipments")
}

// The product catalog used by the supplier form. Populated by importing a
// Sortly CSV export (see /dashboard/products). When empty, the form falls back
// to the bundled Shopify snapshot in lib/catalog.ts.
model Product {
  id        String   @id @default(cuid())
  sku       String?
  name      String
  image     String?
  source    String?  // e.g. "sortly"
  createdAt DateTime @default(now())

  @@index([sku])
  @@schema("shipments")
}

enum Carrier {
  UPS
  FEDEX
  USPS
  DHL
  OTHER

  @@schema("shipments")
}

enum ShippingMethod {
  AIR
  SEA

  @@schema("shipments")
}

enum BoxStatus {
  PENDING        // submitted, not yet picked up / scanned by carrier ("Not shipped")
  IN_TRANSIT
  DELAYED        // stuck: customs / exception / no movement
  DELIVERED      // arrived at warehouse per carrier
  DAMAGED        // arrived damaged
  ADDED_IN_STOCK // received & added to inventory (warehouse)
  LOST

  @@schema("shipments")
}

enum BoxCondition {
  GOOD
  LOST_UNITS

  @@schema("shipments")
}

// Internal "what's coming" list. The team logs expected arrivals (supplier +
// products + rough quantities) so the dashboard shows incoming stock. No
// supplier-facing link; purely for visibility.
model ExpectedArrival {
  id           String          @id @default(cuid())
  supplierName String
  expectedDate DateTime?
  status       ExpectedStatus  @default(EXPECTED)
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  items        ExpectedItem[]

  @@index([status])
  @@schema("shipments")
}

model ExpectedItem {
  id           String          @id @default(cuid())
  arrival      ExpectedArrival @relation(fields: [arrivalId], references: [id], onDelete: Cascade)
  arrivalId    String
  productId    String
  productName  String
  productImage String?
  expectedUnits Int

  @@index([arrivalId])
  @@schema("shipments")
}

enum ExpectedStatus {
  EXPECTED
  ARRIVED
  CANCELLED

  @@schema("shipments")
}

// Record of each daily carrier-tracking refresh (for the "last refreshed"
// indicator and sync history).
model SyncRun {
  id            String   @id @default(cuid())
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  boxesChecked  Int      @default(0)
  statusChanges Int      @default(0)
  ok            Boolean  @default(true)
  trigger       String   @default("cron") // "cron" | "manual"

  @@index([startedAt])
  @@schema("shipments")
}
